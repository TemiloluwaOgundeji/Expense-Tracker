generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category
  paidBy      PaidBy
}

enum Category {
  Food
  Transport
  Shopping
  Bills
  Entertainment
  Other
}

enum PaidBy {
  Me
  Partner
}
